# Copy to .env (read by `npm run dev` and the scripts) and to .dev.vars (read by `wrangler dev`).
# In production these are Worker secrets/vars (see wrangler.jsonc).

# Neon PostgreSQL ------------------------------------------------------------
# Pooled connection string (used by the app over Neon's HTTP driver)
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxxx-pooler.c-9.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Direct (unpooled) connection, used only by drizzle-kit / migrations
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:PASSWORD@ep-xxxx.c-9.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Neon Object Storage (S3-compatible) ---------------------------------------
# `neon env pull` prints the endpoint as AWS_ENDPOINT_URL_S3 and the keys as AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY (token_id / s3_secret_access_key of a storage:read+write credential).
NEON_STORAGE_ENDPOINT=https://br-xxxx.storage.c-9.eu-central-1.aws.neon.tech
NEON_STORAGE_REGION=eu-central-1
NEON_STORAGE_ACCESS_KEY_ID=nak_live_xxxxxxxx
NEON_STORAGE_SECRET_ACCESS_KEY=nsk_live_xxxxxxxx
# public_read bucket: site photos (served straight from the bucket URL)
NEON_STORAGE_BUCKET=media
# private bucket: attachments uploaded with quote requests (only readable through /admin)
NEON_STORAGE_PRIVATE_BUCKET=private

# Auth -----------------------------------------------------------------------
# 32+ random characters: `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
AUTH_SECRET=change-me

# Only for `npm run admin:create` / `npm run db:seed`
ADMIN_EMAIL=info@svelectro.be
ADMIN_NAME=Sooi Valgaeren
ADMIN_PASSWORD=
