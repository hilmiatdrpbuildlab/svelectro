{
	"name": "svelectro",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "npm run build && wrangler dev",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx scripts/migrate.ts",
		"db:seed": "tsx scripts/seed.ts",
		"admin:create": "tsx scripts/create-admin.ts",
		"deploy": "npm run build && wrangler deploy"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1175.0",
		"@neondatabase/serverless": "^1.2.1",
		"drizzle-orm": "^0.45.4",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261123.1",
		"@sveltejs/adapter-cloudflare": "^7.2.10",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^22.20.5",
		"dotenv": "^18.0.10",
		"drizzle-kit": "^0.31.11",
		"sharp": "^0.35.5",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"wrangler": "^4.166.0"
	}
}
